rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for Authentication & Role Checking
    function isAuthenticated() {
      return request.auth != null;
    }

    // Head Office (HO) Superadmin authorization
    function isHoAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'HO_ADMIN' || 
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.admin == true ||
        request.auth.token.email == 'perkedelsayappp@gmail.com'
      );
    }

    // Cashier role authorization (tied to retail stores)
    function isCashier() {
      return isAuthenticated() && (
        request.auth.token.role == 'CASHIER' ||
        isHoAdmin()
      );
    }

    // Member ownership verification
    function isMemberOwner(memberId) {
      return isAuthenticated() && (
        request.auth.uid == memberId ||
        (resource != null && resource.data.googleUid == request.auth.uid) ||
        (resource != null && resource.data.linkedGoogleEmail == request.auth.token.email)
      );
    }

    // Helper: Client SDK cannot directly modify cryptographic credential attributes
    function noCredentialMutation() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'pinHash', 
        'pinSalt', 
        'failedPinAttempts', 
        'lockedUntil'
      ]);
    }

    function noCredentialCreation() {
      return !request.resource.data.keys().hasAny([
        'pinHash', 
        'pinSalt'
      ]);
    }

    // 1. Master Stores Directory (Read for all, write restricted to HO Admin)
    match /stores/{storeId} {
      allow read: if true;
      allow create, update, delete: if isHoAdmin();
    }

    // 2. Sequential Membership ID Counters (Cashiers & HO only)
    match /store_counters/{storeCode} {
      allow read, write: if isCashier() || isHoAdmin();
    }

    // 3. Members Loyalty Profiles & Balances
    match /members/{memberId} {
      // Direct document read: Member owner, Cashier, or HO Admin
      allow get: if isMemberOwner(memberId) || isCashier() || isHoAdmin();

      // List query: Only Cashiers and HO Admin can query member lists
      allow list: if isCashier() || isHoAdmin();

      // New member creation: Cashier, HO Admin, or self-registration without pre-hashed credentials
      allow create: if isCashier() || isHoAdmin() || (isAuthenticated() && request.auth.uid == memberId && noCredentialCreation());

      // Profile updates:
      // HO Admin has full management access.
      // Members can only update their non-ledger profile fields (name, email, address) and cannot modify points, tier, or credentials.
      allow update: if isHoAdmin() || (
        isMemberOwner(memberId) &&
        noCredentialMutation() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'points',
          'lifetimePoints',
          'tier',
          'status',
          'membershipId'
        ])
      );

      // Deletion strictly restricted to HO Admin
      allow delete: if isHoAdmin();
    }

    // 4. Vouchers & Promotional Discounts (Read for all, managed by HO)
    match /vouchers/{voucherId} {
      allow read: if true;
      allow write: if isHoAdmin();
    }

    // 5. POS & Loyalty Transaction Ledger (STRICTLY IMMUTABLE)
    match /transactions/{transactionId} {
      // Read access: HO Admin can read all; Cashier can read store transactions; Member can only read own transactions
      allow get: if isHoAdmin() || isCashier() || (isAuthenticated() && resource.data.memberId == request.auth.uid);
      allow list: if isHoAdmin() || 
        (isCashier() && resource.data.storeId == request.auth.token.storeId) ||
        (isAuthenticated() && resource.data.memberId == request.auth.uid);

      // Creation allowed by authorized Cashiers and HO Admin
      allow create: if isCashier() || isHoAdmin();

      // Ledger is strictly immutable: no updates or deletes permitted
      allow update, delete: if false;
    }

    // 6. Customer Care Support Tickets
    match /support/{ticketId} {
      allow get, list: if isHoAdmin() || isCashier() || (isAuthenticated() && resource.data.memberId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isHoAdmin() || isCashier();
      allow delete: if isHoAdmin();
    }

    // 7. Marketing Campaigns & Announcements (Read for all, managed by HO)
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if isHoAdmin();
    }

    // 8. System Audit Trail (STRICTLY IMMUTABLE)
    match /audit/{auditId} {
      allow read: if isHoAdmin();
      allow create: if isHoAdmin() || isCashier();
      allow update, delete: if false;
    }

    match /audit_logs/{auditId} {
      allow read: if isHoAdmin();
      allow create: if isHoAdmin() || isCashier();
      allow update, delete: if false;
    }

    // 9. Loyalty System Configurations (Read for all, managed by HO)
    match /config/{configId} {
      allow read: if true;
      allow write: if isHoAdmin();
    }
  }
}
