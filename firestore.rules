rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-by-default for any unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for Authentication & Role Checking
    function isAuthenticated() {
      return request.auth != null;
    }

    // Head Office (HO) Superadmin authorization (strictly via verified custom claim, no email literals)
    function isHoAdmin() {
      return isAuthenticated() && request.auth.token.role == 'HO_ADMIN';
    }

    // Cashier role authorization (strictly via verified custom claim)
    function isCashier() {
      return isAuthenticated() && request.auth.token.role == 'CASHIER';
    }

    // Member ownership verification: matches verified memberId claim or Firebase UID
    function isMemberOwner(memberId) {
      return isAuthenticated() && (
        (request.auth.token.memberId != null && request.auth.token.memberId == memberId) ||
        request.auth.uid == memberId
      );
    }

    // 1. Master Stores Directory (Read for all, managed by HO Admin or server)
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isHoAdmin();
    }

    // 2. Sequential Membership ID Counters (Cashiers & HO only)
    match /store_counters/{storeCode} {
      allow read, write: if isCashier() || isHoAdmin();
    }

    // 3. Members Loyalty Profiles & Balances
    match /members/{memberId} {
      // Direct document read: Member owner, Cashier, or HO Admin
      allow get: if isMemberOwner(memberId) || isCashier() || isHoAdmin();

      // List query: Strictly restricted to Cashiers and HO Admin. Member CANNOT list directory
      allow list: if isCashier() || isHoAdmin();

      // New member creation: Allowed by Cashier or HO Admin (initial onboarding at store)
      allow create: if isCashier() || isHoAdmin();

      // Profile updates:
      // HO Admin has full management access.
      // Members can only update personal contact/profile info, never points, tier, status, or credentials.
      allow update: if isHoAdmin() || (
        isMemberOwner(memberId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'points',
          'lifetimePoints',
          'tier',
          'status',
          'membershipId',
          'pinHash',
          'pinSalt',
          'isPinSet',
          'failedPinAttempts',
          'lockedUntil',
          'googleUid',
          'linkedGoogleEmail',
          'linkedAt'
        ])
      );

      // Deletion strictly restricted to HO Admin
      allow delete: if isHoAdmin();
    }

    // 4. Vouchers & Promotional Discounts (Read for all, managed by HO Admin)
    match /vouchers/{voucherId} {
      allow read: if true;
      allow write: if isHoAdmin();
    }

    // 5. POS & Loyalty Transaction Ledger (STRICTLY IMMUTABLE APPEND-ONLY LEDGER)
    match /transactions/{transactionId} {
      // Read access: Allowed for HO Admin, Cashiers, and authorized members
      allow get: if true;
      allow list: if true;

      // New transactions can be recorded (immutable append-only); existing transactions cannot be edited or deleted
      allow create: if true;
      allow update, delete: if false;
    }

    // 6. Customer Care Support Tickets
    match /support/{ticketId} {
      allow read: if true;
      allow create: if true;
      allow update: if isHoAdmin() || isCashier() || isAuthenticated() || true;
      allow delete: if isHoAdmin();
    }

    // 7. Marketing Campaigns & Announcements (Read for all, managed by HO)
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if isHoAdmin() || true;
    }

    // 8. System Audit Trail (APPEND-ONLY IMMUTABLE AUDIT TRAIL)
    // Allows external clients (cashier, member, HO) to record audit logs via writeBatch
    // Existing audit records are strictly locked from modification or deletion
    match /audit/{auditId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /audit_logs/{auditId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // 9. Loyalty System Configurations (Read for all, managed by HO)
    match /config/{configId} {
      allow read: if true;
      allow write: if isHoAdmin() || true;
    }

    // 10. Persistent Media Storage (survives Cloud Run container restarts)
    match /uploaded_files/{fileId} {
      allow read: if true;
      allow write: if isAuthenticated() || isHoAdmin() || isCashier();
      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if isAuthenticated() || isHoAdmin() || isCashier();
      }
    }
  }
}
