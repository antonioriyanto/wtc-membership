{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/member",
      "destination": "https://point.watchclub.co.id/member"
    },
    {
      "source": "/member/:path*",
      "destination": "https://point.watchclub.co.id/member/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
